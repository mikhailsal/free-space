{
  "$defs": {
    "DiffEntry": {
      "properties": {
        "allocated": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "allocated_prev": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "delta": {
          "format": "int64",
          "type": "integer"
        },
        "items": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "items_prev": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "mtime": {
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "newest_mtime": {
          "format": "int64",
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "path_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/DiffStatus"
        }
      },
      "required": [
        "path",
        "name",
        "kind",
        "status",
        "allocated",
        "allocated_prev",
        "delta",
        "items",
        "items_prev",
        "mtime",
        "newest_mtime"
      ],
      "type": "object"
    },
    "DiffResponse": {
      "description": "`diff`: what changed since the previous full scan.",
      "properties": {
        "age_seconds": {
          "description": "Age of the oldest part of the requested subtree.",
          "format": "int64",
          "type": "integer"
        },
        "delta": {
          "description": "allocated(current) − allocated(prev) of the requested path itself.",
          "format": "int64",
          "type": "integer"
        },
        "depth": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/DiffEntry"
          },
          "type": "array"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "host": {
          "type": "string"
        },
        "incomplete": {
          "description": "Some directories could not be read: sizes under `unknown_subtrees` are unknown (D13).\nReport this to the user before any numbers.",
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "limit": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "os": {
          "type": "string"
        },
        "partial": {
          "description": "Subtrees were refreshed after `prev`: deltas mix two baselines.",
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "path_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "prev_generation": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "prev_scanned_at": {
          "format": "int64",
          "type": "integer"
        },
        "refreshed": {
          "items": {
            "$ref": "#/$defs/Refreshed"
          },
          "type": "array"
        },
        "roots_changed": {
          "description": "The root set differs between the generations.",
          "type": "boolean"
        },
        "scanned_at": {
          "description": "Start of the last full scan (UNIX seconds).",
          "format": "int64",
          "type": "integer"
        },
        "schema_version": {
          "format": "int64",
          "type": "integer"
        },
        "snapshot_id": {
          "type": "string"
        },
        "total_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        },
        "unknown_subtrees": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "host",
        "os",
        "generation",
        "scanned_at",
        "age_seconds",
        "schema_version",
        "snapshot_id",
        "incomplete",
        "unknown_subtrees",
        "path",
        "prev_scanned_at",
        "depth",
        "kind",
        "partial",
        "refreshed",
        "roots_changed",
        "delta",
        "entries",
        "total_count",
        "truncated",
        "limit"
      ],
      "type": "object"
    },
    "DiffStatus": {
      "enum": [
        "new",
        "gone",
        "changed",
        "same"
      ],
      "type": "string"
    },
    "DoctorCheck": {
      "description": "One `doctor` check; `fix` is set when it failed.",
      "properties": {
        "detail": {
          "type": "string"
        },
        "fix": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Stable id: `config`, `snapshot`, `timer`, `binary`, `path`, `access`, `space`, `skill`, …",
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "ok",
        "detail"
      ],
      "type": "object"
    },
    "DoctorResponse": {
      "description": "`doctor --json`: exit 0 when `ok`, 1 otherwise.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/DoctorCheck"
          },
          "type": "array"
        },
        "ok": {
          "type": "boolean"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "ok",
        "version",
        "checks"
      ],
      "type": "object"
    },
    "EntryOut": {
      "description": "One snapshot entry.",
      "properties": {
        "allocated": {
          "description": "Bytes on disk (st_blocks × 512), subtree total for directories.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "apparent": {
          "description": "Apparent size (st_size), subtree total for directories.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "denied": {
          "description": "This directory could not be read.",
          "type": "boolean"
        },
        "errors": {
          "description": "Unreadable entries in the subtree.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "hardlink_alias": {
          "description": "Hardlink counted under another path (`allocated` is 0 here).",
          "type": "boolean"
        },
        "hardlink_owner": {
          "description": "For `nlink > 1`: the path that carries the size.",
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "description": "Descendant count (directories).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "mount": {
          "anyOf": [
            {
              "$ref": "#/$defs/MountOut"
            },
            {
              "type": "null"
            }
          ],
          "description": "Filesystem mounted here (kind = mount)."
        },
        "mtime": {
          "description": "UNIX seconds; 0 = unknown.",
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "newest_mtime": {
          "description": "Newest file inside (directories) or `min(mtime, scanned_at)` (files); 0 = unknown.",
          "format": "int64",
          "type": "integer"
        },
        "nlink": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Full path, UTF-8 (invalid bytes replaced).",
          "type": "string"
        },
        "path_raw": {
          "description": "Hex of the exact path bytes; present only when `path` is lossy. Pass it\nback with `--path-raw` / `?path_raw=`.",
          "type": [
            "string",
            "null"
          ]
        },
        "scanned_at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "name",
        "kind",
        "allocated",
        "apparent",
        "mtime",
        "newest_mtime",
        "nlink",
        "items",
        "errors",
        "scanned_at"
      ],
      "type": "object"
    },
    "ErrorBody": {
      "description": "`{\"error\": {...}}` printed on stdout under `--json` (D16).",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "oneOf": [
        {
          "const": "GENERIC",
          "description": "Unexpected failure (I/O, SQLite, publish step).",
          "type": "string"
        },
        {
          "const": "SPACE",
          "description": "Not enough free space for a new snapshot (precheck or reserve).",
          "type": "string"
        },
        {
          "const": "USAGE",
          "description": "Bad command line or query parameter.",
          "type": "string"
        },
        {
          "const": "CONFIG",
          "description": "`config.toml` unreadable or invalid.",
          "type": "string"
        },
        {
          "const": "GUI_NO_TTY",
          "description": "`gui` without a terminal on stdin and stdout.",
          "type": "string"
        },
        {
          "const": "PATH_NOT_FOUND",
          "description": "The path is not in the snapshot.",
          "type": "string"
        },
        {
          "const": "NO_PREV",
          "description": "`diff` without a previous generation.",
          "type": "string"
        },
        {
          "const": "ROTATED",
          "description": "The snapshot rotated between opening current and prev.",
          "type": "string"
        },
        {
          "const": "SCHEMA",
          "description": "Snapshot schema differs from this binary.",
          "type": "string"
        },
        {
          "const": "LOCK",
          "description": "Another scan or refresh holds the lock.",
          "type": "string"
        },
        {
          "const": "HASH_COLLISION",
          "description": "Two paths share a path hash in a diff answer.",
          "type": "string"
        },
        {
          "const": "NO_SNAPSHOT",
          "description": "No snapshot published yet.",
          "type": "string"
        },
        {
          "const": "SNAPSHOT_ACCESS",
          "description": "The snapshot exists but this user cannot read it.",
          "type": "string"
        },
        {
          "const": "NOT_ROOT",
          "description": "Operation needs root.",
          "type": "string"
        },
        {
          "const": "NOT_SUPPORTED",
          "description": "Feature not available on this OS or host.",
          "type": "string"
        }
      ]
    },
    "ErrorContext": {
      "properties": {
        "config": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastError"
            },
            {
              "type": "null"
            }
          ],
          "description": "`state.json` last_error, when it explains this failure."
        },
        "scanning": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scanning"
            },
            {
              "type": "null"
            }
          ],
          "description": "Running scan, when the lock is held."
        },
        "snapshot_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "type": "object"
    },
    "ErrorDetail": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "context": {
          "$ref": "#/$defs/ErrorContext"
        },
        "docs": {
          "type": "string"
        },
        "exit": {
          "format": "int32",
          "type": "integer"
        },
        "fix": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "recovery": {
          "$ref": "#/$defs/Recovery"
        }
      },
      "required": [
        "code",
        "exit",
        "message",
        "recovery",
        "context",
        "docs"
      ],
      "type": "object"
    },
    "FindEntry": {
      "description": "One snapshot entry.",
      "properties": {
        "allocated": {
          "description": "Bytes on disk (st_blocks × 512), subtree total for directories.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "apparent": {
          "description": "Apparent size (st_size), subtree total for directories.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "denied": {
          "description": "This directory could not be read.",
          "type": "boolean"
        },
        "errors": {
          "description": "Unreadable entries in the subtree.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "hardlink_alias": {
          "description": "Hardlink counted under another path (`allocated` is 0 here).",
          "type": "boolean"
        },
        "hardlink_owner": {
          "description": "For `nlink > 1`: the path that carries the size.",
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "description": "Descendant count (directories).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "mount": {
          "anyOf": [
            {
              "$ref": "#/$defs/MountOut"
            },
            {
              "type": "null"
            }
          ],
          "description": "Filesystem mounted here (kind = mount)."
        },
        "mtime": {
          "description": "UNIX seconds; 0 = unknown.",
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "nested": {
          "description": "Inside another matched directory: counted in `total.count` only.",
          "type": "boolean"
        },
        "newest_mtime": {
          "description": "Newest file inside (directories) or `min(mtime, scanned_at)` (files); 0 = unknown.",
          "format": "int64",
          "type": "integer"
        },
        "nlink": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Full path, UTF-8 (invalid bytes replaced).",
          "type": "string"
        },
        "path_raw": {
          "description": "Hex of the exact path bytes; present only when `path` is lossy. Pass it\nback with `--path-raw` / `?path_raw=`.",
          "type": [
            "string",
            "null"
          ]
        },
        "scanned_at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "name",
        "kind",
        "allocated",
        "apparent",
        "mtime",
        "newest_mtime",
        "nlink",
        "items",
        "errors",
        "scanned_at",
        "nested"
      ],
      "type": "object"
    },
    "FindResponse": {
      "description": "`find`: matches under a path, with totals over all of them.",
      "properties": {
        "age_seconds": {
          "description": "Age of the oldest part of the requested subtree.",
          "format": "int64",
          "type": "integer"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/FindEntry"
          },
          "type": "array"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "host": {
          "type": "string"
        },
        "incomplete": {
          "description": "Some directories could not be read: sizes under `unknown_subtrees` are unknown (D13).\nReport this to the user before any numbers.",
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "limit": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "os": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "path_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "prev_generation": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scanned_at": {
          "description": "Start of the last full scan (UNIX seconds).",
          "format": "int64",
          "type": "integer"
        },
        "schema_version": {
          "format": "int64",
          "type": "integer"
        },
        "snapshot_id": {
          "type": "string"
        },
        "sort": {
          "type": "string"
        },
        "total": {
          "$ref": "#/$defs/Total",
          "description": "Over all matches, not just `entries`."
        },
        "total_allocated": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        },
        "unknown_subtrees": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "host",
        "os",
        "generation",
        "scanned_at",
        "age_seconds",
        "schema_version",
        "snapshot_id",
        "incomplete",
        "unknown_subtrees",
        "path",
        "kind",
        "sort",
        "entries",
        "total",
        "total_count",
        "total_allocated",
        "truncated",
        "limit"
      ],
      "type": "object"
    },
    "FsOut": {
      "properties": {
        "avail": {
          "description": "Available now (live statvfs); null when the mount is gone.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fs_type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "total": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "used": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "fs_type",
        "total",
        "used"
      ],
      "type": "object"
    },
    "Kind": {
      "oneOf": [
        {
          "enum": [
            "file",
            "dir",
            "symlink",
            "other"
          ],
          "type": "string"
        },
        {
          "const": "mount",
          "description": "Mount point under a root: shown, never traversed.",
          "type": "string"
        }
      ]
    },
    "LastError": {
      "properties": {
        "message": {
          "type": "string"
        },
        "op": {
          "description": "Step that failed: \"scan\", \"refresh\", \"precheck\", \"write\", \"reserve\", \"publish\".",
          "type": "string"
        },
        "ts": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "op",
        "message"
      ],
      "type": "object"
    },
    "LsResponse": {
      "description": "`ls`: the children of one folder.",
      "properties": {
        "age_seconds": {
          "description": "Age of the oldest part of the requested subtree.",
          "format": "int64",
          "type": "integer"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/EntryOut"
          },
          "type": "array"
        },
        "entry": {
          "$ref": "#/$defs/EntryOut"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "host": {
          "type": "string"
        },
        "incomplete": {
          "description": "Some directories could not be read: sizes under `unknown_subtrees` are unknown (D13).\nReport this to the user before any numbers.",
          "type": "boolean"
        },
        "limit": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "os": {
          "type": "string"
        },
        "prev_generation": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scanned_at": {
          "description": "Start of the last full scan (UNIX seconds).",
          "format": "int64",
          "type": "integer"
        },
        "schema_version": {
          "format": "int64",
          "type": "integer"
        },
        "snapshot_id": {
          "type": "string"
        },
        "sort": {
          "type": "string"
        },
        "total_count": {
          "description": "Number of children of `entry`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        },
        "unknown_subtrees": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "host",
        "os",
        "generation",
        "scanned_at",
        "age_seconds",
        "schema_version",
        "snapshot_id",
        "incomplete",
        "unknown_subtrees",
        "entry",
        "entries",
        "total_count",
        "truncated",
        "limit",
        "sort"
      ],
      "type": "object"
    },
    "MountOut": {
      "properties": {
        "fs_type": {
          "type": "string"
        },
        "root": {
          "description": "The scanned root for this mount point, when it is in the root set.",
          "type": [
            "string",
            "null"
          ]
        },
        "total": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "used": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "fs_type"
      ],
      "type": "object"
    },
    "PrevOut": {
      "properties": {
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scanned_at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "generation",
        "scanned_at"
      ],
      "type": "object"
    },
    "Progress": {
      "properties": {
        "elapsed_seconds": {
          "format": "int64",
          "type": "integer"
        },
        "entries_expected": {
          "description": "Used inodes of the scanned filesystems; null when unavailable.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "entries_seen": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "op": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "percent": {
          "description": "0–99 until publish; null without `entries_expected`.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "stage": {
          "description": "\"walk\", \"write\" or \"publish\"",
